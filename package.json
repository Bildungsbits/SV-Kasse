{
  "name": "sv-kasse",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "wrangler dev --port 8787",
    "dev:web": "vite",
    "build": "vite build",
    "db:migrate:local": "wrangler d1 migrations apply sv-kasse --local",
    "db:migrate:remote": "wrangler d1 migrations apply sv-kasse --remote",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root .",
    "docs:pdf": "node scripts/anleitung-pdf.mjs"
  },
  "dependencies": {
    "hono": "^4.13.17",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@preact/preset-vite": "^2.10.6",
    "miniflare": "^5.20261109.0-beta",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "wrangler": "^4.159.0"
  }
}
